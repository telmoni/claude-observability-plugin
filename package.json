{
  "name": "telmoni-claude-observability-plugin",
  "version": "0.1.0",
  "description": "Telmoni for Claude Code: each turn of a session recorded as a run, metadata only",
  "license": "Apache-2.0",
  "author": "Kendrick Lawton",
  "homepage": "https://github.com/telmoni/claude-observability-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telmoni/claude-observability-plugin.git"
  },
  "keywords": [
    "telmoni",
    "claude-code",
    "plugin",
    "observability",
    "agents"
  ],
  "type": "module",
  "files": [
    ".claude-plugin/plugin.json",
    "hooks",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild": false
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "telmoni": "file:../telmoni/sdk/typescript",
    "tsup": "^8.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
